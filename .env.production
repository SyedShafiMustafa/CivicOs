# Production build default: same-origin API via the Vercel services rewrite
# (vercel.json proxies /api/backend/* to the FastAPI service).
# NOTE: this is the FULL prefix - endpoint paths like "/stats/overview" are
# appended directly. Local development overrides it in .env.local (not
# committed) with http://localhost:8000/api.
NEXT_PUBLIC_API_URL=/api/backend
